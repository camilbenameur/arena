[Unit]
Description=Arena perp league: the wick hunter (reads the prices every 5 s, plays the frozen rule; paper)
After=network-online.target
Wants=network-online.target
# 10 restarts in 10 minutes at most, then the unit stays failed (an alert beats a crash loop)
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/arena
ExecStart=%h/arena/.venv/bin/python -m arena.perp.hunter run
# on-failure, not always: `enabled = false` exits 0 and a second instance exits 2 (the lock): neither restarts
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=2
# A daily restart reloads the specs and the configuration. At RuntimeMaxSec systemd stops the unit with its result set
# to "timeout", a failure for Restart=on-failure, which therefore restarts it (checked with a transient unit:
# systemd-run --user -p RuntimeMaxSec=3 -p Restart=on-failure sleep 1000 restarts every 3 s). Restart=always would
# also restart after `enabled = false`, and a plain on-success would not restart after the timeout.
RuntimeMaxSec=86400
MemoryMax=1G
Nice=0

[Install]
WantedBy=default.target
