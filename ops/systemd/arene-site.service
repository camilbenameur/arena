[Unit]
Description=Arène de trading : dashboard statique privé (127.0.0.1:8787)

[Service]
WorkingDirectory=%h/dev/arene-trading
ExecStartPre=/usr/bin/mkdir -p %h/dev/arene-trading/var/site
ExecStart=%h/dev/arene-trading/.venv/bin/python -m http.server 8787 --bind 127.0.0.1 --directory %h/dev/arene-trading/var/site
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
