[Unit]
Description=Arène de trading : reconstruit le dashboard statique (après un réveil)

[Service]
Type=oneshot
WorkingDirectory=%h/dev/arene-trading
# Lancé par `arene veille` après un réveil terminé (systemctl --user start --no-block), hors du processus de veille.
ExecStart=%h/dev/arene-trading/.venv/bin/arene build-site
TimeoutStartSec=600
Nice=10
