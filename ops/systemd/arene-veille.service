[Unit]
Description=Arène de trading : un tick de veille (stops en direct, réveil éventuel)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/dev/arene-trading
# Même venv et mêmes secrets que le cycle. Le tick prend le verrou du cycle sans attendre : si un cycle ou un
# réveil tourne, il sort sans rien écrire (code 0). Un réveil appelle les modèles (jusqu'à 150 s) puis reconstruit le site.
ExecStart=%h/dev/arene-trading/.venv/bin/arene veille
TimeoutStartSec=600
Nice=5
